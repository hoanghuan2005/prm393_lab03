rules_version = '2';

// Firebase Cloud Storage Rules for Why I Buy (PRM393 Lab 3)
// Requires authenticated user and restricts access strictly to owner's path
service firebase.storage {
  match /b/{bucket}/o {
    // Only the owner UID can read or write their own exported reports
    match /reports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for all other paths to comply with security requirements
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
