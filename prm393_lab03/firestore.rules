rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Chrome extension linked by QR: signs in anonymously; the phone approved
    // users/{uid}/extensionSessions/{that anonymous uid}
    function linkedDevice(uid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(uid)/extensionSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(uid)/extensionSessions/$(request.auth.uid)).data.status == 'approved';
    }
    // Owner, or a linked extension (data the extension syncs: wishlist, prices, decisions, budgets…)
    function canAccess(uid) { return isOwner(uid) || linkedDevice(uid); }
    function isAnonymous() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // Roles (Final 6): users/{uid}.role is 'user' (also when the field or the document is
    // missing), 'staff' or 'admin'. The first admin is set in the Firebase console; after that
    // only an admin changes roles, and nobody changes their own.
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function roleOf(uid) { return exists(userDoc(uid)) ? get(userDoc(uid)).data.get('role', 'user') : 'user'; }
    function isStaff() { return request.auth != null && roleOf(request.auth.uid) in ['staff', 'admin']; }
    function isAdmin() { return request.auth != null && roleOf(request.auth.uid) == 'admin'; }
    function unchanged(fields) { return !d().diff(resource.data).affectedKeys().hasAny(fields); }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function d() { return request.resource.data; }
    function validTitle() { return d().title is string && d().title.size() > 0 && d().title.size() <= 60; }
    function validMotive(m) { return m in ['need','want','sale','emotion','social','convenience','ads','other']; }
    function validMoney(v) { return v is int && v > 0 && v <= 999999999; }
    function optionalNote() { return !('note' in d()) || d().note == null || (d().note is string && d().note.size() <= 200); }
    // Shopee ratings read by the extension (P0-chart): stars in (0, 5], review count int ≥ 0
    function optionalText(f, max) { return !(f in d()) || text(d()[f], max); }
    function optionalRating(f) { return !(f in d()) || (d()[f] is number && d()[f] > 0 && d()[f] <= 5); }
    function optionalCount(f) { return !(f in d()) || (d()[f] is int && d()[f] >= 0); }
    function validRatings() {
      return optionalRating('productRating') && optionalRating('shopRating') && optionalCount('productRatingCount');
    }
    function optionalStars(f) { return !(f in d()) || d()[f] == null || (d()[f] is int && d()[f] >= 1 && d()[f] <= 5); }

    match /users/{uid} {
      // Staff read profiles for the web user list
      allow read: if isOwner(uid) || isStaff() || linkedDevice(uid);
      // Created on first sign-in as a plain user; the owner never changes the role
      allow create: if isOwner(uid) && d().get('role', 'user') == 'user';
      allow update: if (isOwner(uid) && d().get('role', 'user') == resource.data.get('role', 'user'))
        || (isAdmin() && request.auth.uid != uid
          && d().diff(resource.data).affectedKeys().hasOnly(['role'])
          && d().role in ['user', 'staff', 'admin']);
      allow delete: if isOwner(uid);

      match /purchases/{id} {
        allow read: if isAdmin() || canAccess(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTitle() && validMoney(d().amountVnd)
          && validMotive(d().motive) && d().occurredAt is timestamp && optionalNote()
          && optionalStars('satisfaction');
      }

      match /wishlistItems/{id} {
        allow read: if isAdmin() || canAccess(uid);
        allow delete: if canAccess(uid);
        allow create, update: if canAccess(uid) && validTitle()
          && d().status in ['considering','purchased','skipped']
          && (!('motive' in d()) || d().motive == null || validMotive(d().motive))
          && (!('priority' in d()) || (d().priority is int && d().priority >= 1 && d().priority <= 5))
          && (!('latestPriceVnd' in d()) || d().latestPriceVnd == null || validMoney(d().latestPriceVnd))
          && optionalNote()
          // Chrome extension fields; only the app's purchase batch marks an item purchased
          && (!('variantLabel' in d()) || d().variantLabel == null || (d().variantLabel is string && d().variantLabel.size() <= 60))
          && (!('shopName' in d()) || d().shopName == null || (d().shopName is string && d().shopName.size() <= 100))
          && (!('buyIntentAt' in d()) || d().buyIntentAt == null || d().buyIntentAt is timestamp)
          && validRatings()
          && (d().status != 'purchased' || ('purchaseId' in d() && d().purchaseId is string));

        match /priceSnapshots/{sid} {
          allow read, delete: if canAccess(uid);
          allow create: if canAccess(uid) && validMoney(d().amountVnd) && d().observedAt is timestamp
            && (!('source' in d()) || d().source in ['manual','demo','extensionPage','community'])
            && (!('priceType' in d()) || d().priceType in ['single','range','flash','sale','afterVoucher'])
            // Shop and ratings on the page when the extension read the price
            && optionalText('shopName', 60) && validRatings();
          allow update: if false;
        }
      }

      // Chrome extension linked with this account. Google sign-in (old): created pending by the
      // extension, decided on the phone. QR (new): the phone scans and creates it approved with
      // id = the extension's anonymous uid. The extension may read and revoke its own session.
      match /extensionSessions/{sid} {
        allow read: if isOwner(uid) || (request.auth != null && request.auth.uid == sid);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && d().status in ['pending','approved']
          && d().deviceLabel is string && d().deviceLabel.size() > 0 && d().deviceLabel.size() <= 60;
        allow update: if (isOwner(uid) && d().status in ['pending','approved','rejected','revoked'])
          || (request.auth != null && request.auth.uid == sid && d().status == 'revoked');
      }

      match /decisions/{id} {
        allow read: if canAccess(uid);
        allow delete: if isOwner(uid);
        allow create: if canAccess(uid) && d().choice in ['buy','wait','skip','undo'];
        allow update: if false;
      }

      match /budgetGroups/{id} { allow read, write: if isOwner(uid); }

      // "Gửi góp ý" (Cá nhân → Hỗ trợ & thông tin): written once, never edited
      match /feedback/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && d().message is string && d().message.size() > 0 && d().message.size() <= 1000;
        allow update: if false;
      }

      // Shopping profile (spec 7.2): things the user owns, typed by the user
      match /ownedItems/{id} {
        allow read: if canAccess(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().name is string && d().name.size() > 0 && d().name.size() <= 60
          && d().tags is list && d().tags.size() <= 8
          && (!('note' in d()) || d().note == null || (d().note is string && d().note.size() <= 100));
      }

      match /budgets/{month} {
        allow read: if canAccess(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$');
      }

      // Hộp thư: personal messages written by staff (e.g. the answer to a feedback).
      // The owner only marks a message read or deletes it.
      match /inbox/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isStaff()
          && d().keys().hasOnly(['title', 'body', 'kind', 'refId', 'createdAt', 'createdBy', 'readAt'])
          && text(d().title, 80) && text(d().body, 500)
          && d().kind in ['message', 'feedback_reply', 'suggestion_reply']
          && (!('refId' in d()) || text(d().refId, 128))
          && d().createdAt == request.time && d().createdBy == request.auth.uid
          && (!('readAt' in d()) || d().readAt == null);
        allow update: if isOwner(uid)
          && d().diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && d().readAt is timestamp;
      }

      match /reflections/{month} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$')
          && d().rating is int && d().rating >= 1 && d().rating <= 5;
      }
    }

    // "Giá người khác ghi" (spec 8.3): anonymous prices shared between users. A report holds
    // no uid; its id must be sha256("uid|productKey|modelKey"), so each Google account has one
    // report per product variant and nobody writes under someone else's id. Guests and
    // linked extensions (anonymous) only read, so one person cannot count as several.
    function sharedReportId(productKey, modelKey) {
      return hashing.sha256(request.auth.uid + '|' + productKey + '|' + modelKey).toHexString().lower();
    }
    match /sharedPrices/{productKey}/reports/{rid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && !isAnonymous()
        && productKey.matches('^shopee:[0-9]{1,20}:[0-9]{1,20}$')
        && d().keys().hasOnly(['modelKey','priceType','amountVnd','observedAt','source'])
        && d().modelKey is string && d().modelKey.matches('^(none|[0-9]{1,20})$')
        && rid == sharedReportId(productKey, d().modelKey)
        && validMoney(d().amountVnd)
        && d().priceType in ['single','range','flash']
        && d().source in ['manual','extensionPage']
        && d().observedAt is timestamp
        && d().observedAt <= request.time + duration.value(5, 'm')
        && d().observedAt > request.time - duration.value(3, 'd');
      allow delete: if request.auth != null && !isAnonymous()
        && rid == sharedReportId(productKey, resource.data.modelKey);
    }

    // "Biểu đồ giá tham khảo": prices per product over time, read by every signed-in user.
    // Admins write sample data (isDemo / source 'demo'); signed-in non-guest users add their
    // own anonymous price per day (G7). afterVoucher is stored but never counted as a list
    // price (app side).
    function isContributor() { return request.auth != null && !isAnonymous(); }
    // yyyyMMdd of t in Vietnam (UTC+7), like PriceHistoryIds.dayKey in the app
    function vnDayKey(t) {
      let vn = t + duration.value(7, 'h');
      return string(vn.year())
        + (vn.month() < 10 ? '0' : '') + string(vn.month())
        + (vn.day() < 10 ? '0' : '') + string(vn.day());
    }
    // sha256("uid|productKey|modelKey|yyyyMMdd"): one report per person, variant and day;
    // the uid itself is never stored
    function historyReportId(productKey, modelKey, observedAt) {
      return hashing.sha256(request.auth.uid + '|' + productKey + '|' + modelKey + '|'
        + vnDayKey(observedAt)).toHexString().lower();
    }
    function validHistoryProduct(productKey) {
      return productKey.matches('^shopee:[0-9]{1,20}:[0-9]{1,20}$')
        && d().keys().hasOnly(['title','shopId','itemId','shopName','groupId','isDemo','createdAt'])
        && text(d().title, 120) && text(d().shopName, 60)
        && d().shopId is string && d().itemId is string
        && productKey == 'shopee:' + d().shopId + ':' + d().itemId
        && optionalText('groupId', 128)
        && d().isDemo is bool && d().createdAt is timestamp;
    }
    // A user's product: like G1, isDemo false, shopName may be missing until someone knows it
    function validRealProduct(productKey) {
      return productKey.matches('^shopee:[0-9]{1,20}:[0-9]{1,20}$')
        && d().keys().hasOnly(['title','shopId','itemId','shopName','groupId','isDemo','createdAt'])
        && text(d().title, 120) && optionalText('shopName', 60)
        && d().shopId is string && d().itemId is string
        && productKey == 'shopee:' + d().shopId + ':' + d().itemId
        && optionalText('groupId', 128)
        && d().isDemo == false && d().createdAt is timestamp;
    }
    // Only shopName / groupId change, and each was missing or null before
    function onlyFillsEmpty() {
      let changed = d().diff(resource.data).affectedKeys();
      return changed.hasOnly(['shopName', 'groupId'])
        && (!changed.hasAny(['shopName']) || resource.data.get('shopName', null) == null)
        && (!changed.hasAny(['groupId']) || resource.data.get('groupId', null) == null);
    }
    function validHistoryReport() {
      return d().keys().hasOnly(['amountVnd','priceType','modelKey','observedAt','source','shopName',
                                 'productRating','productRatingCount','shopRating'])
        && validMoney(d().amountVnd)
        && d().priceType in ['single','range','flash','sale','afterVoucher']
        && d().modelKey is string && d().modelKey.matches('^(none|[0-9]{1,20})$')
        && d().observedAt is timestamp
        && d().source in ['manual','extensionPage','demo']
        && optionalText('shopName', 60)
        && optionalRating('productRating') && optionalRating('shopRating')
        && (!('productRatingCount' in d()) || (d().productRatingCount is int && d().productRatingCount >= 0));
    }
    match /priceHistory/{productKey} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && validHistoryProduct(productKey) && d().isDemo == true;
      allow update: if isAdmin() && resource.data.isDemo == true
        && validHistoryProduct(productKey) && d().isDemo == true;
      allow delete: if isAdmin() && resource.data.isDemo == true;
      // G7: a real product, created by the first user who reports a price for it (shop
      // name may still be unknown). Later users only fill a field that is still empty
      // (shopName, groupId); title, ids, isDemo and createdAt never change. No delete.
      allow create: if isContributor() && validRealProduct(productKey)
        && d().createdAt == request.time;
      allow update: if isContributor() && resource.data.isDemo == false
        && validRealProduct(productKey) && onlyFillsEmpty();

      // Sample report id: demo<n>_<modelKey>_<yyyyMMdd>
      match /reports/{rid} {
        allow read: if request.auth != null;
        // G7: the user's own price, under their hashed id only, observed within 3 days
        allow create, update: if isContributor()
          && productKey.matches('^shopee:[0-9]{1,20}:[0-9]{1,20}$')
          && validHistoryReport() && d().source in ['manual', 'extensionPage']
          && rid == historyReportId(productKey, d().modelKey, d().observedAt)
          // Never into sample data; getAfter also sees a product created in the same batch
          && getAfter(/databases/$(database)/documents/priceHistory/$(productKey)).data.isDemo == false
          && d().observedAt <= request.time + duration.value(5, 'm')
          && d().observedAt > request.time - duration.value(3, 'd');
        allow create: if isAdmin() && validHistoryReport() && d().source == 'demo'
          && rid.matches('^demo[0-9]{1,6}_' + d().modelKey + '_[0-9]{8}$');
        allow update: if isAdmin() && resource.data.source == 'demo'
          && validHistoryReport() && d().source == 'demo' && d().modelKey == resource.data.modelKey;
        allow delete: if isAdmin() && resource.data.source == 'demo';
      }
    }
    match /productGroups/{groupId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && d().isDemo == true
        && (resource == null || resource.data.isDemo == true)
        && d().keys().hasOnly(['name','productKeys','isDemo'])
        && text(d().name, 120) && d().productKeys is list && d().productKeys.size() <= 50;
      allow delete: if isAdmin() && resource.data.isDemo == true;
    }

    // QR linking: the extension (anonymous) creates a pending request and shows its id as a QR.
    // Only someone holding the id can read it (no list); a signed-in, non-anonymous app user
    // approves it for their own uid or rejects it, once.
    match /extensionPairings/{pid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && d().anonUid == request.auth.uid && d().status == 'pending'
        && d().deviceLabel is string && d().deviceLabel.size() > 0 && d().deviceLabel.size() <= 60
        && d().keys().hasOnly(['anonUid','deviceLabel','status','createdAt']);
      allow update: if request.auth != null && !isAnonymous()
        && resource.data.status == 'pending' && request.auth.uid != resource.data.anonUid
        && d().anonUid == resource.data.anonUid && d().deviceLabel == resource.data.deviceLabel
        && ((d().status == 'approved' && d().ownerUid == request.auth.uid)
          || d().status == 'rejected');
      allow delete: if request.auth != null && request.auth.uid == resource.data.anonUid;
    }

    // Thông báo chung (web announcement form → mobile inbox). Never deleted: archived instead.
    function validAnnouncement() {
      return d().keys().hasOnly(['title', 'body', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && text(d().title, 80) && text(d().body, 500)
        && d().createdAt is timestamp && d().updatedAt == request.time;
    }
    match /announcements/{id} {
      // Signed-in users see published ones; a list query must filter status == 'published'
      allow read: if request.auth != null && (resource.data.status == 'published' || isStaff());
      allow create: if isStaff() && validAnnouncement() && d().status == 'published'
        && d().createdAt == request.time && d().createdBy == request.auth.uid;
      // published → published (edit) or archived; an archived one stays archived
      allow update: if isStaff() && validAnnouncement() && resource.data.status == 'published'
        && d().status in ['published', 'archived'] && unchanged(['createdAt', 'createdBy']);
      allow delete: if false;
    }

    // Lịch sale managed on the web (the team follows the shops' official announcements).
    function validSaleEvent() {
      return d().keys().hasOnly(['name', 'date', 'type', 'confirmed', 'status', 'updatedAt', 'updatedBy',
                                 'suggestionId'])
        && text(d().name, 40) && d().date is timestamp
        // Set once, by the batch that approves a user's suggestion
        && (!('suggestionId' in d()) || text(d().suggestionId, 128))
        && d().type in ['double_day', 'mid_month', 'payday', 'other']
        && d().confirmed is bool
        && d().updatedAt == request.time && d().updatedBy == request.auth.uid;
    }
    match /saleEvents/{id} {
      allow read: if request.auth != null && (resource.data.status == 'published' || isStaff());
      allow create: if isStaff() && validSaleEvent() && d().status in ['draft', 'published'];
      // draft → draft/published/archived; published → published/archived; archived is final
      allow update: if isStaff() && validSaleEvent()
        && ((resource.data.status == 'draft' && d().status in ['draft', 'published', 'archived'])
          || (resource.data.status == 'published' && d().status in ['published', 'archived']));
      allow delete: if false;
    }

    // Đề xuất đợt sale (cross-role flow): a user proposes a sale on the app (pending);
    // staff approve it (the same batch publishes the saleEvent and writes the user's
    // inbox) or reject it with a reason. Only pending → approved | rejected, once.
    match /saleSuggestions/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if request.auth != null && !isAnonymous()
        && d().uid == request.auth.uid && d().status == 'pending'
        && d().keys().hasOnly(['uid', 'name', 'date', 'note', 'status', 'createdAt'])
        && text(d().name, 40) && d().date is timestamp && optionalNote()
        && d().createdAt == request.time;
      allow update: if isStaff() && resource.data.status == 'pending'
        && d().diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'reviewedAt', 'reviewedBy', 'saleEventId'])
        && d().reviewedBy == request.auth.uid && d().reviewedAt == request.time
        && ((d().status == 'approved' && d().saleEventId is string
              && existsAfter(/databases/$(database)/documents/saleEvents/$(d().saleEventId)))
          || (d().status == 'rejected' && text(d().reason, 200)));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Web dashboard: count / sum over every user's wishlist and purchases (collection
    // group queries). Admins only; staff see the dashboard without these figures.
    match /{path=**}/wishlistItems/{itemId} {
      allow list: if isAdmin();
    }
    match /{path=**}/purchases/{purchaseId} {
      allow list: if isAdmin();
    }

  }
}
