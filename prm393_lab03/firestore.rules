rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Role lives in users/{uid}.role ('user' | 'admin'); a missing field means 'user'.
    // The first admin is set by hand in the Firebase console (see README).
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isAdmin() {
      return signedIn() && exists(userDoc(request.auth.uid))
        && get(userDoc(request.auth.uid)).data.get('role', 'user') == 'admin';
    }
    function d() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function validText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function validTitle() { return d().title is string && d().title.size() > 0 && d().title.size() <= 60; }
    function validMotive(m) { return m in ['need','want','sale','emotion','social','convenience','ads','other']; }
    function validMoney(v) { return v is int && v > 0 && v <= 999999999; }
    function optionalNote() { return !('note' in d()) || d().note == null || (d().note is string && d().note.size() <= 200); }
    function optionalStars(f) { return !(f in d()) || d()[f] == null || (d()[f] is int && d()[f] >= 1 && d()[f] <= 5); }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Nobody gives themselves a role: a new profile is 'user' (or has no role yet)
      allow create: if isOwner(uid) && (!('role' in d()) || d().role == 'user');
      // The owner edits everything but the role; an admin edits only the role, never their own
      allow update: if (isOwner(uid) && !changed().hasAny(['role']))
        || (isAdmin() && !isOwner(uid) && changed().hasOnly(['role']) && d().role in ['user', 'admin']);
      allow delete: if isOwner(uid);

      // Inbox: written by an admin when a sale suggestion is reviewed; the owner only marks it read
      match /inbox/{messageId} {
        allow read, delete: if isOwner(uid);
        allow create: if isAdmin()
          && d().keys().hasOnly(['type', 'title', 'body', 'suggestionId', 'createdAt', 'read'])
          && d().type in ['suggestion_approved', 'suggestion_rejected']
          && validText(d().title, 80) && validText(d().body, 500)
          && d().suggestionId is string && d().read == false && d().createdAt == request.time;
        allow update: if isOwner(uid) && changed().hasOnly(['read']) && d().read is bool;
      }

      match /purchases/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTitle() && validMoney(d().amountVnd)
          && validMotive(d().motive) && d().occurredAt is timestamp && optionalNote()
          && optionalStars('satisfaction');
      }

      match /wishlistItems/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTitle()
          && d().status in ['considering','purchased','skipped']
          && (!('motive' in d()) || d().motive == null || validMotive(d().motive))
          && (!('priority' in d()) || (d().priority is int && d().priority >= 1 && d().priority <= 5))
          && (!('latestPriceVnd' in d()) || d().latestPriceVnd == null || validMoney(d().latestPriceVnd))
          && optionalNote()
          // Chrome extension fields; only the app's purchase batch marks an item purchased
          && (!('variantLabel' in d()) || d().variantLabel == null || (d().variantLabel is string && d().variantLabel.size() <= 60))
          && (!('buyIntentAt' in d()) || d().buyIntentAt == null || d().buyIntentAt is timestamp)
          && (d().status != 'purchased' || ('purchaseId' in d() && d().purchaseId is string));

        match /priceSnapshots/{sid} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validMoney(d().amountVnd) && d().observedAt is timestamp
            && (!('source' in d()) || d().source in ['manual','demo','extensionPage'])
            && (!('priceType' in d()) || d().priceType in ['single','range','flash','afterVoucher']);
          allow update: if false;
        }
      }

      // Chrome extension linked with this account: created pending by the extension,
      // approved / rejected / revoked on the phone (the extension may revoke itself)
      match /extensionSessions/{sid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && d().status == 'pending'
          && d().deviceLabel is string && d().deviceLabel.size() > 0 && d().deviceLabel.size() <= 60;
        allow update: if isOwner(uid) && d().status in ['pending','approved','rejected','revoked'];
      }

      match /decisions/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && d().choice in ['buy','wait','skip','undo'];
        allow update: if false;
      }

      match /budgetGroups/{id} { allow read, write: if isOwner(uid); }

      // "Gửi góp ý" (Cá nhân → Hỗ trợ & thông tin): written once, never edited
      match /feedback/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && d().message is string && d().message.size() > 0 && d().message.size() <= 1000;
        allow update: if false;
      }

      // Shopping profile (spec 7.2): things the user owns, typed by the user
      match /ownedItems/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().name is string && d().name.size() > 0 && d().name.size() <= 60
          && d().tags is list && d().tags.size() <= 8
          && (!('note' in d()) || d().note == null || (d().note is string && d().note.size() <= 100));
      }

      match /budgets/{month} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$');
      }

      match /reflections/{month} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$')
          && d().rating is int && d().rating >= 1 && d().rating <= 5;
      }
    }

    // Sale calendar managed on the web admin, read by the app. Never deleted: archived instead.
    function validSaleEvent() {
      return d().keys().hasOnly(['name', 'date', 'type', 'confirmed', 'status', 'source',
                                 'suggestionId', 'createdAt', 'updatedAt', 'createdBy'])
        && validText(d().name, 60) && d().date is timestamp
        && d().type in ['double_day', 'mid_month', 'payday', 'other']
        && d().confirmed is bool && d().status in ['published', 'archived']
        && d().source in ['admin', 'suggestion'] && d().updatedAt == request.time;
    }
    match /saleEvents/{eventId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow create: if isAdmin() && validSaleEvent() && d().status == 'published'
        && d().createdAt == request.time && d().createdBy == request.auth.uid;
      allow update: if isAdmin() && validSaleEvent()
        && !changed().hasAny(['createdAt', 'createdBy', 'source', 'suggestionId']);
      allow delete: if false;
    }

    // A user proposes a sale on the app (pending); an admin approves or rejects it with a reason
    match /saleSuggestions/{suggestionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && d().uid == request.auth.uid && d().status == 'pending'
        && d().keys().hasOnly(['uid', 'name', 'date', 'note', 'status', 'createdAt'])
        && validText(d().name, 60) && d().date is timestamp && optionalNote()
        && d().createdAt == request.time;
      allow update: if isAdmin() && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'reason', 'reviewedAt', 'reviewedBy', 'saleEventId'])
        && d().reviewedBy == request.auth.uid && d().reviewedAt == request.time
        && ((d().status == 'approved' && d().saleEventId is string
              && existsAfter(/databases/$(database)/documents/saleEvents/$(d().saleEventId)))
            || (d().status == 'rejected' && validText(d().reason, 200)));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Announcements written on the web admin, shown in every app inbox
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow create: if isAdmin()
        && d().keys().hasOnly(['title', 'body', 'status', 'createdAt', 'updatedAt', 'createdBy'])
        && validText(d().title, 80) && validText(d().body, 1000) && d().status == 'published'
        && d().createdAt == request.time && d().updatedAt == request.time
        && d().createdBy == request.auth.uid;
      allow update: if isAdmin() && changed().hasOnly(['status', 'updatedAt'])
        && d().status in ['published', 'archived'] && d().updatedAt == request.time;
      allow delete: if false;
    }

    // Dashboard aggregation (count / sum) across every user's wishlist: admins only
    match /{path=**}/wishlistItems/{itemId} {
      allow list: if isAdmin();
    }
  }
}